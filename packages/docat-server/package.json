{
  "name": "docat-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"const fs=require('fs');const{join}=require('path');const s=join('src','runtime');const d=join('dist','runtime');fs.mkdirSync(d,{recursive:true});for(const f of ['runtime-js.mjs','runtime-py.py']){fs.copyFileSync(join(s,f),join(d,f))}\"",
    "start": "node --experimental-transform-types dist/server.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "docat-shared": "workspace:*",
    "fastify": "^5.11.2",
    "mathjs": "^15.2.0",
    "serialport": "^13.0.0",
    "ssh2-sftp-client": "^12.1.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
