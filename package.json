{
  "name": "docat",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source device orchestration and automation toolkit - Client-Server architecture for Dobot robots",
  "scripts": {
    "dev": "turbo run dev --filter=docat-server --filter=docat-web",
    "build": "turbo run build",
