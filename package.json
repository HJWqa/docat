    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "dependencies": {
    "turbo": "^2.9.16"
  }
}
