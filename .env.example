# Environment variable examples.
# Root .env files are not loaded automatically by pnpm dev.
# Export these in your shell, or put frontend-only values in packages/docat-web/.env.local.

# Backend service
DOCAT_HOST=0.0.0.0
DOCAT_PORT=9100
DOCAT_DB_PATH=./data/docat.db
DOCAT_SCAN_IPS=192.168.5.1,192.168.201.1,127.0.0.1
DOCAT_POLL_INTERVAL=500
DOCAT_LOG_LEVEL=info
DOCAT_AUTO_CONNECT=true
DOCAT_SESSION_EXPIRE_DAYS=30

# Vite dev proxy target. This is read by packages/docat-web/vite.config.ts.
# It is not exposed to browser code.
DOCAT_SERVER_URL=http://127.0.0.1:9100

# Browser-side direct backend URL. Leave unset for normal development and LAN access
# through the Vite dev server proxy. Set only when the frontend is served without
# a reverse proxy for /api and /ws, for example from static hosting.
# VITE_DOCAT_SERVER_URL=http://192.168.1.20:9100
